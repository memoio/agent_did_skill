{
  "name": "@memo/agent-did-mainnet-skill",
  "version": "1.0.0-preprod",
  "description": "Portable MEMO Mainnet chain-985 Agent DID skill and local signing runtime",
  "license": "UNLICENSED",
  "type": "module",
  "engines": { "node": ">=22.5.0" },
  "bin": { "memo-agent-mainnet": "bin/memo-agent-mainnet" },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist", "src", "bin", "scripts", "examples", "SKILL.md", "skill.json",
    "agents", "references", "schemas", "policy", "tsconfig.json", ".npmrc"
