{
  "name": "memo-agent-did-mainnet",
  "version": "1.0.0-preprod",
  "identityProtocolVersion": "memo-agent-did/2",
  "managementProtocolVersion": "memo-agent-management/4",
  "cli": "memo-agent-mainnet",
  "chainId": 985,
  "transport": "erc-4337-v0.7",
  "capabilities": [
    "identity.ensure.local",
    "identity.key.migrate",
    "identity.register.chain",
    "identity.resolve.chain",
    "identity.status",
    "identity.profile.update",
    "identity.document.update",
    "identity.suspend",
    "identity.resume",
    "identity.revoke",
    "instance.create",
    "instance.default.reconcile",
    "instance.revoke",
    "auth.signChallenge",
    "agent.session.challenge",
    "agent.request.long-poll",
    "pairing.create",
    "pairing.cancel",
    "management.inspect",
    "management.accept.chain",
    "management.renew.chain",
    "management.end.chain",
    "management.transfer.chain",
    "management.reject"
  ],
  "signerTypes": ["os-keyring", "env-master-key"],
  "output": "application/json",
  "networkPolicy": {
    "local": ["http://127.0.0.1", "http://localhost"],
    "preprod": "explicit-https-allowlist",
    "production": "explicit-https-allowlist"
  },
  "stateNamespace": ".memo-agent-mainnet",
  "keyringService": "com.memo.agent-did.mainnet",
  "forbiddenIntegrations": ["data-did-resolver", "old-agent-did-state-import", "private-key-export"],
  "limitations": [
    "No silent migration from Anvil-31337, preprod, or another installation",
    "No private-key export",
    "Production R4 approval service and KMS/HSM backup are deployment responsibilities"
  ]
}
