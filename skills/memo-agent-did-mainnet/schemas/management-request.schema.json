{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "memo.management-request/3",
  "type": "object",
  "properties": {
    "requestId": { "type": "string", "minLength": 1 },
    "relationshipId": { "type": "string", "minLength": 1 },
    "agentDid": { "type": "string", "pattern": "^did:memo:agent:[0-9]+:0x[0-9a-f]{40}$" },
    "managerAccount": { "type": "string", "pattern": "^eip155:[0-9]+:0x[0-9a-f]{40}$" },
    "managementScopes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "issuedAt": { "type": "integer", "minimum": 0 },
    "expiresAt": { "type": "integer", "minimum": 0 },
    "termEndsAt": { "type": "integer", "minimum": 0 },
    "visibility": { "enum": ["public", "private"] },
    "requestVersion": { "type": "integer", "minimum": 0 },
    "relationshipRevision": { "type": "integer", "minimum": 0 },
    "source": { "type": "string", "minLength": 1 }
    ,"managerSignature": { "type": "string", "pattern": "^0x[0-9a-fA-F]{130}$" }
  },
  "required": ["requestId", "relationshipId", "agentDid", "managerAccount", "managementScopes", "issuedAt", "expiresAt", "termEndsAt", "visibility", "requestVersion", "relationshipRevision", "source", "managerSignature"],
  "additionalProperties": false
}
