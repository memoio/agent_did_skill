{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memo.example/schemas/agent-pairing-package-v2.json",
  "title": "MEMO Agent Pairing Package v2",
  "type": "object",
  "required": [
    "schema", "kind", "exchangeId", "platformOrigin", "environment", "chainId",
    "didRegistry", "managementRegistry", "handle", "issuedAt", "expiresAt"
  ],
  "properties": {
    "schema": { "const": "memo.agent-pairing-package/2" },
    "kind": { "enum": ["platform-invitation", "agent-offer"] },
    "exchangeId": { "type": "string", "pattern": "^(pinv|poff)_[A-Za-z0-9_-]{12,100}$" },
    "platformOrigin": { "type": "string", "format": "uri" },
    "environment": { "enum": ["local", "preprod", "production"] },
    "chainId": { "const": 985 },
    "didRegistry": { "$ref": "#/$defs/address" },
    "managementRegistry": { "$ref": "#/$defs/address" },
    "handle": { "type": "string", "pattern": "^memo-pair-v2\\.(pinv|poff)_[A-Za-z0-9_-]{12,100}\\.[A-Za-z0-9_-]{40,}$" },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "managerAccount": { "$ref": "#/$defs/address" },
    "agentDid": { "type": "string", "pattern": "^did:memo:agent:985:0x[0-9a-f]{40}$" },
    "identityAccount": { "$ref": "#/$defs/address" },
    "profileHash": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "requestedScopes": { "$ref": "#/$defs/scopes" },
    "requestedTermSeconds": { "$ref": "#/$defs/term" },
    "visibility": { "enum": ["private", "public"] },
    "maxScopes": { "$ref": "#/$defs/scopes" },
    "maxTermSeconds": { "$ref": "#/$defs/term" }
  },
  "oneOf": [
    {
      "properties": { "kind": { "const": "platform-invitation" }, "exchangeId": { "pattern": "^pinv_" } },
      "required": ["managerAccount", "requestedScopes", "requestedTermSeconds", "visibility"],
      "not": { "anyOf": [
        { "required": ["agentDid"] }, { "required": ["identityAccount"] }, { "required": ["profileHash"] },
        { "required": ["maxScopes"] }, { "required": ["maxTermSeconds"] }
      ] }
    },
    {
      "properties": { "kind": { "const": "agent-offer" }, "exchangeId": { "pattern": "^poff_" } },
      "required": ["agentDid", "identityAccount", "profileHash", "maxScopes", "maxTermSeconds"],
      "not": { "anyOf": [
        { "required": ["managerAccount"] }, { "required": ["requestedScopes"] },
        { "required": ["requestedTermSeconds"] }, { "required": ["visibility"] }
      ] }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "address": { "type": "string", "pattern": "^0x[0-9A-Fa-f]{40}$", "not": { "const": "0x0000000000000000000000000000000000000000" } },
    "scopes": {
      "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,63}$" }
    },
    "term": { "type": "integer", "minimum": 60, "maximum": 31536000 }
  }
}
